        super.onCreate(savedInstanceState)

        setContent {
            MaterialTheme {
                TravelPackingApp()
            }
        }
    }
}

@Composable
fun TravelPackingApp() {

    // SCREEN NAVIGATION
    var currentScreen by remember {
        mutableStateOf("Home")
    }

    // PARALLEL ARRAYS
    val itemNames = remember {
        arrayOfNulls<String>(50).apply {
            this[0] = "Passport"
            this[1] = "Phone Charger"
            this[2] = "Clothes"
            this[3] = "Toothbrush"
            this[4] = "Sunscreen"
            this[5] = "Wallet"
        }
    }

    val categories = remember {
        arrayOfNulls<String>(50).apply {
            this[0] = "Documents"
            this[1] = "Electronics"
            this[2] = "Clothing"
            this[3] = "Toiletries"
            this[4] = "Toiletries"
            this[5] = "Essentials"
        }
    }

    val quantities = remember {
        arrayOfNulls<String>(50).apply {
            this[0] = "1"
            this[1] = "1"
            this[2] = "5"
            this[3] = "1"
            this[4] = "1"
            this[5] = "1"
        }
    }

    val comments = remember {
        arrayOfNulls<String>(50).apply {
            this[0] = "Keep it safe"
            this[1] = "Pack before leaving"
            this[2] = "Choose comfortable clothes"
            this[3] = "Travel size"
            this[4] = "For sunny days"
            this[5] = "Check before leaving"
        }
    }

    // CHECKLIST ARRAY
    val packedItems = remember {
        BooleanArray(50)
    }

    // NUMBER OF ITEMS
    var itemCount by remember {
        mutableIntStateOf(6)
    }

    // REFRESH SCREEN AFTER CHANGES
    var refresh by remember {
        mutableIntStateOf(0)
    }

    Surface(
        modifier = Modifier.fillMaxSize(),
        color = androidx.compose.ui.graphics.Color(0xFFF2F7FF)
    ) {

        when (currentScreen) {

            "Home" -> {

                HomeScreen(
                    onViewList = {
                        currentScreen = "Packing List"
                    },
                    onAddItem = {
                        currentScreen = "Add Item"
                    },
                    onAbout = {
                        currentScreen = "About"
                    }
                )
            }

            "Packing List" -> {

                PackingListScreen(
                    itemNames = itemNames,
                    categories = categories,
                    quantities = quantities,
                    comments = comments,
                    packedItems = packedItems,
                    itemCount = itemCount,
                    refresh = refresh,
                    onBack = {
                        currentScreen = "Home"
                    },
                    onAdd = {
                        currentScreen = "Add Item"
                    },
                    onToggle = { index, checked ->
                        packedItems[index] = checked
                        refresh++
                    },
                    onClear = {
                        for (i in 0 until itemCount) {
                            packedItems[i] = false
                        }
                        refresh++
                    }
                )
            }

            "Add Item" -> {

                AddItemScreen(
                    onBack = {
                        currentScreen = "Home"
                    },
                    onSave = { name, category, quantity, comment ->

                        if (itemCount < 50 && name.isNotBlank()) {

                            itemNames[itemCount] = name
                            categories[itemCount] = category
                            quantities[itemCount] = quantity
                            comments[itemCount] = comment

                            packedItems[itemCount] = false

                            itemCount++
                            refresh++

                            currentScreen = "Packing List"
                        }
                    }
                )
            }

            "About" -> {

                AboutScreen(
                    onBack = {
                        currentScreen = "Home"
                    }
                )
            }
        }
    }
}


// HOME SCREEN

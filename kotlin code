}


// PACKING LIST SCREEN
@Composable
fun PackingListScreen(
    itemNames: Array<String?>,
    categories: Array<String?>,
    quantities: Array<String?>,
    comments: Array<String?>,
    packedItems: BooleanArray,
    itemCount: Int,
    refresh: Int,
    onBack: () -> Unit,
    onAdd: () -> Unit,
    onToggle: (Int, Boolean) -> Unit,
    onClear: () -> Unit
) {

    Column(
        modifier = Modifier
            .fillMaxSize()
            .padding(16.dp)
    ) {

        Text(
            text = "My Packing List",
            fontSize = 27.sp,
            color = MaterialTheme.colorScheme.primary
        )

        Spacer(modifier = Modifier.height(10.dp))

        Text("Total Items: $itemCount")

        val packedCount = (0 until itemCount).count {
            packedItems[it]
        }

        Text("Packed: $packedCount / $itemCount")

        LinearProgressIndicator(
            progress = {
                if (itemCount == 0) 0f
                else packedCount.toFloat() / itemCount
            },
            modifier = Modifier
                .fillMaxWidth()
                .padding(vertical = 10.dp)
        )

        Spacer(modifier = Modifier.height(10.dp))

        // LOOP THROUGH THE PARALLEL ARRAYS
        key(refresh) {

            Column(
                modifier = Modifier
                    .weight(1f)
                    .fillMaxWidth()
                    .verticalScroll(rememberScrollState())
            ) {

                for (i in 0 until itemCount) {

                    Card(
                        modifier = Modifier
                            .fillMaxWidth()
                            .padding(vertical = 5.dp)
                    ) {

                        Row(
                            modifier = Modifier.padding(10.dp),
                            verticalAlignment = Alignment.CenterVertically
                        ) {

                            Checkbox(
                                checked = packedItems[i],
                                onCheckedChange = {
                                    onToggle(i, it)
                                }
                            )

                            Column(
                                modifier = Modifier.weight(1f)
                            ) {

                                Text(
                                    text = itemNames[i] ?: "",
                                    fontSize = 18.sp
                                )

                                Text(
                                    text = "Category: ${categories[i]}"
                                )

                                Text(
                                    text = "Quantity: ${quantities[i]}"
                                )

                                Text(
                                    text = "Comment: ${comments[i]}"
                                )
                            }
                        }
                    }
                }
            }
        }

        Button(
            onClick = onAdd,
            modifier = Modifier.fillMaxWidth()
        ) {
            Text("＋ Add New Item")
        }

        Spacer(modifier = Modifier.height(8.dp))

        OutlinedButton(
            onClick = onClear,
            modifier = Modifier.fillMaxWidth()
        ) {
            Text("Clear All Checkboxes")
        }

        TextButton(
            onClick = onBack,
            modifier = Modifier.align(Alignment.CenterHorizontally)
        ) {
            Text("Back to Home")
        }
    }
}


// ADD ITEM SCREEN
@Composable
fun AddItemScreen(
    onBack: () -> Unit,
    onSave: (String, String, String, String) -> Unit
) {

    var name by remember { mutableStateOf("") }
    var category by remember { mutableStateOf("Essentials") }
    var quantity by remember { mutableStateOf("1") }
    var comment by remember { mutableStateOf("") }

    val categoryOptions = listOf(
        "Essentials",
        "Documents",
        "Clothing",
        "Electronics",
        "Toiletries",
        "Other"
    )

    Column(
        modifier = Modifier
            .fillMaxSize()
            .padding(20.dp)
            .verticalScroll(rememberScrollState())
    ) {

        Text(
            text = "Add New Item",
            fontSize = 27.sp,
            color = MaterialTheme.colorScheme.primary
        )

        Spacer(modifier = Modifier.height(20.dp))

        OutlinedTextField(
            value = name,
            onValueChange = { name = it },
            label = { Text("Item Name") },
            modifier = Modifier.fillMaxWidth()
        )

        Spacer(modifier = Modifier.height(12.dp))

        Text("Choose Category")

        categoryOptions.forEach { option ->

            Row(
                verticalAlignment = Alignment.CenterVertically
            ) {

                RadioButton(
                    selected = category == option,
                    onClick = { category = option }
                )

                Text(option)
            }
        }

        Spacer(modifier = Modifier.height(12.dp))

        OutlinedTextField(
            value = quantity,
            onValueChange = { quantity = it },
            label = { Text("Quantity") },
            modifier = Modifier.fillMaxWidth()
        )

        Spacer(modifier = Modifier.height(12.dp))

        OutlinedTextField(
            value = comment,
            onValueChange = { comment = it },
            label = { Text("Comments") },
            modifier = Modifier.fillMaxWidth()
        )

        Spacer(modifier = Modifier.height(25.dp))

        Button(
            onClick = {
                if (name.isNotBlank() &&
                    (quantity.toIntOrNull() ?: 0) > 0
                ) {
                    onSave(
                        name.trim(),
                        category,
                        quantity,
                        comment
                    )
                }
            },
            modifier = Modifier.fillMaxWidth(),
            enabled = name.isNotBlank() &&
                (quantity.toIntOrNull() ?: 0) > 0
        ) {
            Text("Save Item")
        }

        TextButton(
            onClick = onBack,
            modifier = Modifier.align(Alignment.CenterHorizontally)
        ) {
            Text("Cancel")
        }
    }
}


